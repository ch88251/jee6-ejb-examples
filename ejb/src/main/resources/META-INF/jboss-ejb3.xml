<?xml version="1.0" encoding="UTF-8"?>
<!--
  JBoss EAP 6 additions to ejb-jar.xml; other servers ignore this file. JBoss
  merges it with ejb-jar.xml, so it only holds what differs.

  JBoss doesn't use <mapped-name> to choose an MDB's queue. It reads the
  "destination" activation property, which names the HornetQ queue created in
  docker/configure-eap.cli.
-->
<jboss:ejb-jar xmlns:jboss="http://www.jboss.com/xml/ns/javaee"
               xmlns="http://java.sun.com/xml/ns/javaee"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee http://www.jboss.org/j2ee/schema/jboss-ejb3-2_0.xsd
                                   http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/ejb-jar_3_1.xsd"
               version="3.1"
               impl-version="2.0">
    <enterprise-beans>
        <message-driven>
            <ejb-name>PriceChangeMDB</ejb-name>
            <activation-config>
                <activation-config-property>
                    <activation-config-property-name>destination</activation-config-property-name>
                    <activation-config-property-value>java:/jms/queue/PriceChangeQueue</activation-config-property-value>
                </activation-config-property>
            </activation-config>
        </message-driven>
    </enterprise-beans>
</jboss:ejb-jar>
