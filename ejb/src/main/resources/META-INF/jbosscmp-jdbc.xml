<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jbosscmp-jdbc PUBLIC
    "-//JBoss//DTD JBOSSCMP-JDBC 4.0//EN"
    "http://www.jboss.org/j2ee/dtd/jbosscmp-jdbc_4_0.dtd">
<!--
  JBoss EAP 6 CMP mapping for ProductEJB; GlassFish uses glassfish-ejb-jar.xml
  instead and other servers ignore this file. Needs the server's "cmp" subsystem
  (enabled in standalone-full.xml).

  Uses EAP's built-in H2 datasource. "Hypersonic SQL" is the bundled type
  mapping JBoss uses for it. The table is created at deploy time. ExampleDS is
  an in-memory database, so the data lasts until the server restarts.
-->
<jbosscmp-jdbc>
    <defaults>
        <datasource>java:jboss/datasources/ExampleDS</datasource>
        <datasource-mapping>Hypersonic SQL</datasource-mapping>
        <create-table>true</create-table>
        <remove-table>false</remove-table>
        <pk-constraint>true</pk-constraint>
    </defaults>
    <enterprise-beans>
        <entity>
            <ejb-name>ProductEJB</ejb-name>
            <table-name>PRODUCT</table-name>
            <cmp-field>
                <field-name>sku</field-name>
                <column-name>SKU</column-name>
            </cmp-field>
            <cmp-field>
                <field-name>name</field-name>
                <column-name>NAME</column-name>
            </cmp-field>
            <cmp-field>
                <field-name>price</field-name>
                <column-name>PRICE</column-name>
            </cmp-field>
        </entity>
    </enterprise-beans>
</jbosscmp-jdbc>
