<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-ejb-jar PUBLIC
    "-//GlassFish.org//DTD GlassFish Application Server 3.1 EJB 3.1//EN"
    "http://glassfish.org/dtds/glassfish-ejb-jar_3_1-1.dtd">
<!--
  GlassFish-specific CMP setup. CMP table mapping isn't standardized, so each
  server needs its own descriptor; other servers ignore this file.

  No sun-cmp-mappings.xml is supplied, so GlassFish generates the mapping and
  creates the table at deploy time ("Java2DB"). It uses the built-in
  Derby datasource jdbc/__default; start Derby with `asadmin start-database`.
-->
<glassfish-ejb-jar>
    <enterprise-beans>
        <cmp-resource>
            <jndi-name>jdbc/__default</jndi-name>
            <create-tables-at-deploy>true</create-tables-at-deploy>
            <drop-tables-at-undeploy>true</drop-tables-at-undeploy>
        </cmp-resource>
    </enterprise-beans>
</glassfish-ejb-jar>
