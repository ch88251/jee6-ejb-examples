<?xml version="1.0" encoding="UTF-8"?>
<!--
  JBoss EAP 6 bindings for the resource references declared in web.xml; other
  servers ignore this file. Each jndi-name replaces the web.xml mapped-name
  (a GlassFish-style name that doesn't exist on JBoss).
-->
<jboss-web xmlns="http://www.jboss.com/xml/ns/javaee"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee http://www.jboss.org/j2ee/schema/jboss-web_7_2.xsd"
           version="7.2">
    <!-- java:comp/env/jms/ConnectionFactory: HornetQ's pooled, transaction-aware factory -->
    <resource-ref>
        <res-ref-name>jms/ConnectionFactory</res-ref-name>
        <jndi-name>java:/JmsXA</jndi-name>
    </resource-ref>
    <!-- java:comp/env/jms/PriceChangeQueue: the queue created in docker/configure-eap.cli -->
    <message-destination-ref>
        <message-destination-ref-name>jms/PriceChangeQueue</message-destination-ref-name>
        <jndi-name>java:/jms/queue/PriceChangeQueue</jndi-name>
    </message-destination-ref>
</jboss-web>
