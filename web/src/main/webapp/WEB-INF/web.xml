<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>POJO + Redis Examples</display-name>

    <!-- Creates the services (connected to Redis) at startup and stores them
         as servlet context attributes. This replaces the ejb-local-ref,
         resource-ref and message-destination-ref entries and their JNDI names. -->
    <listener>
        <listener-class>com.example.web.AppContextListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>ShoppingCartServlet</servlet-name>
        <servlet-class>com.example.web.ShoppingCartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShoppingCartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CurrencyConverterServlet</servlet-name>
        <servlet-class>com.example.web.CurrencyConverterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CurrencyConverterServlet</servlet-name>
        <url-pattern>/converter</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductServlet</servlet-name>
        <servlet-class>com.example.web.ProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductServlet</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PriceChangeServlet</servlet-name>
        <servlet-class>com.example.web.PriceChangeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PriceChangeServlet</servlet-name>
        <url-pattern>/pricing</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
